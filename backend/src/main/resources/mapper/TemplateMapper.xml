<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaoying.template.TemplateMapper">

    <resultMap id="templateMap" type="com.xiaoying.template.TemplateEntity" autoMapping="true">
        <id property="id" column="id"/>
        <result property="acceptedMimeTypes" column="accepted_mime_types"
                typeHandler="com.xiaoying.common.StringListTypeHandler"/>
    </resultMap>

    <sql id="columns">
        id, category_id, title, cover_url, description, required_image_count,
        accepted_mime_types, max_file_size_bytes, sort_order, created_at
    </sql>

    <select id="findAll" resultMap="templateMap">
        SELECT <include refid="columns"/>
        FROM template
        <where>
            <if test="categoryId != null">category_id = #{categoryId}</if>
        </where>
        ORDER BY sort_order, id
    </select>

    <select id="findById" resultMap="templateMap">
        SELECT <include refid="columns"/>
        FROM template
        WHERE id = #{id}
    </select>
</mapper>
