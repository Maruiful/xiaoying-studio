<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaoying.asset.AssetMapper">

    <!-- 只返回属于该用户的素材；调用方保证 ids 非空 -->
    <select id="findOwnedByIds" resultType="com.xiaoying.asset.AssetEntity">
        SELECT id, user_id, template_id, original_name, mime_type, size_bytes, storage_path, created_at
        FROM asset
        WHERE user_id = #{userId}
          AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
