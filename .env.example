# 复制为 .env 后按需修改。这里都是本地演示用的示例值，不是真实凭据。

# MySQL
DB_NAME=xiaoying
DB_USER=xiaoying
DB_PASSWORD=xiaoying
DB_ROOT_PASSWORD=root

# 宿主机端口（容器内端口固定）。MySQL 默认映射到 3307，避免和本机已有的 MySQL 冲突
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# 身份 cookie 是否加 Secure，部署到 https 时设为 true
COOKIE_SECURE=false

# 模拟生成器（启动默认值，运行时可通过 PUT /api/dev/simulation 修改）
DEV_API_ENABLED=true
SIM_CHECK_ASSETS_MS=1000
SIM_GENERATE_MS=3000
SIM_ORGANIZE_RESULT_MS=1000
# NONE / CHECK_ASSETS / GENERATE / ORGANIZE_RESULT
SIM_FAIL_STAGE=NONE

# 前端镜像构建时使用的 npm 源，国内网络可改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
